APP_NAME=Mini Hotel API
APP_ENV=development
API_PREFIX=/api

# Run FastAPI on your machine, MySQL in Docker mapped as 4000:3306.
DATABASE_URL=mysql+pymysql://hotel_user:hotel_password@127.0.0.1:4000/hotel_manage

# If you run the backend service inside docker-compose, use:
# DATABASE_URL=mysql+pymysql://hotel_user:hotel_password@mysql:3306/hotel_manage
